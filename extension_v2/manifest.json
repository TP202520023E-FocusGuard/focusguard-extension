{
  "manifest_version": 3,
  "name": "FocusGuard",
  "description": "Track the time spended in web procrastination",
  "version": "1.0",
  "key": "",
  "icons": {
    "16": "images/timer-blue-16.png",
    "32": "images/timer-blue-32.png",
    "48": "images/timer-blue-48.png",
    "128": "images/timer-blue-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "images/timer-blue-16.png",
      "32": "images/timer-blue-32.png",
      "48": "images/timer-blue-48.png",
      "128": "images/timer-blue-128.png"
    },
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*"
    ]
  },
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}